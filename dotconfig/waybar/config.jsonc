{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    "modules-left": [],
    "modules-center": [
        "custom/applauncher",
        "hyprland/workspaces",
        "clock",
        "pulseaudio",
        "battery",
        "tray",
        "custom/notification",
        "custom/wlogout"
    ],
    "modules-right": [],

    "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "persistent-only": true,
    "persistent-workspaces": {
        "*": [1,2,3,4]
    }
},

    "clock": {
        "format": " {:%b %d, %H:%M } ",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "mode"   // toggles between normal and alt format
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol",
        "tooltip": true
    },

    "battery": {
        "states": {
			      "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8,
        "show-passive-items": true
    },

    "custom/notification": {
        "tooltip": false,
        "format": "",
        "on-click": "swaync-client -t -sw",
        "escape": true,
        "return-type": "json"   // future-proof if you want dynamic count later
    },
    "custom/applauncher": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },
  	"custom/wlogout": {
  		"format": "󰍃",
  		"tooltip": false,
  		"on-click": "wlogout"
  	}
}
